# https://editorconfig.org
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
# Trailing spaces in Markdown can be a line break — don't strip them.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
