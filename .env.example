# Copy this file to `.env` and fill in the keys for the providers you want
# to exercise. `.env` is gitignored; this template is not.
#
# Used by:
#   - `npm run test:integration` (root)
#   - the runnable demos in `examples/` (each example also has its own
#     `.env.example` listing only the keys it actually needs)
#
# Leave a value blank to skip tests/examples that require it — the
# integration suite uses `node --test`'s skip support to no-op when a key
# is missing, so partial coverage is fine.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
KIMI_API_KEY=

# Microsoft Foundry — endpoint is the resource (or project) endpoint, e.g.
# https://my-resource.services.ai.azure.com. Model names are *deployment* names.
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
# Deployment for the v1 / dated / Model Inference tests (default gpt-6-luna).
FOUNDRY_MODEL=
# Optional: enables the Claude-on-Foundry and reasoning-model tests.
FOUNDRY_CLAUDE_MODEL=
FOUNDRY_REASONER_MODEL=
