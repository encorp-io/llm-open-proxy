# Copy to `.env` and fill in. The proxy routes by model prefix:
#   `claude*`   → Anthropic
#   `gemini*`   → Google
#   `deepseek*` → DeepSeek
#   `foundry/<deployment>` → Microsoft Foundry (`foundry/claude*` → Claude on Foundry)
#   anything else → OpenAI
# Set only the keys for the providers you actually want to route to.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
# Microsoft Foundry resource endpoint, e.g. https://my-resource.services.ai.azure.com
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
